# Groq API key (get one from https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Model used to generate answers. Confirm availability with /openai/v1/models.
GROQ_MODEL=openai/gpt-oss-20b

# API key that YOUR clients/widget must send in the X-API-Key header
APP_API_KEY=change-this-to-a-long-random-string

# Where Chroma stores its vector database on disk
CHROMA_DIR=./data/chroma

# Where the SQLite metadata database lives (documents + query logs)
SQLITE_PATH=./data/app.db

# If the best matching chunk scores below this similarity, we say "I don't know"
# (Chroma returns distance, lower = more similar; tune this after testing)
MAX_DISTANCE_THRESHOLD=1.1

# How many previous turns of a conversation to remember per session
MAX_HISTORY_TURNS=6

# How many chunks to retrieve per question
TOP_K=4
